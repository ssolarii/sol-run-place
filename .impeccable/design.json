  "narrative": {
    "northStar": "The shallow leaf archive",
    "overview": "Dark foliage surrounds Sol's work, with carved timber holding project imagery and matte paper carrying readable content. Material objects provide character; live HTML carries navigation, project copy, forms and links. This records the implemented archive and project page, not a replacement for the fast homepage's established design.\n\nThree curved leaves share a fixed orthographic camera. Restrained movement belongs to their shallow layers. The portfolio remains an ordinary scrolling document with immediate Projects, About and Quicklinks destinations.",
    "keyCharacteristics": [
      "Green-black ground, pale ink and a restrained leaf accent.",
      "Self-hosted Helvetica Now with heavy headings and regular reading text.",
      "Timber, paper and foliage as specific materials.",
      "Semantic controls and static fallbacks beneath graphics."
    ],
    "rules": [
      {
        "name": "The Live Ink Rule",
        "body": "Keep headings, captions, links and forms as semantic HTML; the moving note temporarily paints matching ink into its bending texture.",
        "section": "typography"
      },
      {
        "name": "The Settled Paper Rule",
        "body": "The flat note is a whole HTML surface. Peeling bends one continuous 96-row WebGL sheet with paper texture and note ink over 450ms with cubic ease-out. Reduced motion snaps to the target, including when enabled mid-transition.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep navigation, reading and submissions usable without decorative graphics.",
      "**Do** preserve self-hosted fonts, approved imagery and honest image descriptions.",
      "**Do** keep motion shallow, optional and still for reduced motion.",
      "**Do** preserve entered messages on failed or uncertain delivery."
    ],
    "donts": [
      "**Don't** substitute an island, terrain or primitive fern garden for the split leaves.",
      "**Don't** rasterize the interface or invent biography, project evidence or personal notes.",
      "**Don't** add automatic audio or camera travel in Z.",
      "**Don't** present pending guestbook notes as published entries."
    ]
  }
